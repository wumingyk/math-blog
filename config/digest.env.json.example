# 每日资讯聚合系统 - 环境配置模板
# 复制此文件为 digest.env.json 并填入你的 API Keys

{
  "ai": {
    "provider": "qwen",
    "apiKey": "your-qwen-api-key-here",
    "model": "qwen-turbo"
  },
  "sources": {
    "bilibili": {
      "enabled": true,
      "count": 10
    },
    "twitter": {
      "enabled": false,
      "accounts": ["elonmusk", "sama"],
      "bearerToken": "your-twitter-bearer-token-here"
    },
    "weibo": {
      "enabled": false,
      "categories": ["科技", "AI"]
    }
  }
}
